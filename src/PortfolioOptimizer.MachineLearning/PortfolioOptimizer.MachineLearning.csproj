<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!--
    Pure ML research engine: features, labels, time-aware validation, models, evaluation, ML portfolio construction and
    walk-forward backtests. No I/O. It references the Optimization project only for shared statistics and the
    engine-agnostic PortfolioSimulator – never for the mean-variance optimizer (enforced by an architecture test).
  -->
  <ItemGroup>
    <ProjectReference Include="..\PortfolioOptimizer.Optimization\PortfolioOptimizer.Optimization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PortfolioOptimizer.MachineLearning.Tests" />
  </ItemGroup>

</Project>
