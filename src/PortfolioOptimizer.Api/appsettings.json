{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=data/portfolio.db"
  },
  "MarketData": {
    "DefaultProvider": "Yahoo",
    "DefaultHistoryYears": 5,
    "ScheduledRefreshEnabled": true,
    "ScheduledRefreshIntervalHours": 12,
    "ScheduledRefreshInitialDelayMinutes": 5,
    "Yahoo": { "Enabled": true, "MinRequestIntervalMs": 500, "TimeoutSeconds": 20 },
    "AlphaVantage": { "ApiKey": "", "UseAdjustedEndpoint": false, "MinRequestIntervalMs": 1500 },
    "Mock": { "Enabled": true }
  },
  "Seed": {
    "Assets": true,
    "DemoPortfolio": true,
    "SyncOnEmptyDatabase": true,
    "InitialHistoryYears": 5
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "RateLimiting": {
    "PermitPerMinute": 600,
    "ExpensivePermitPerMinute": 30
  },
  "RequestTimeoutSeconds": 120
}
