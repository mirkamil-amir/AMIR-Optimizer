# Copy to .env (never commit .env). Used by docker-compose.yml.
# Market data provider used on first start: Yahoo | AlphaVantage | Mock
MARKET_DATA_PROVIDER=Yahoo
# Optional – only needed for the Alpha Vantage provider. Placeholder value only.
ALPHAVANTAGE_API_KEY=your-alpha-vantage-key-here
ASPNETCORE_ENVIRONMENT=Development
