# Copy to .env (never commit .env). Used by docker-compose.yml. Replace every placeholder.

# --- PostgreSQL -------------------------------------------------------------------------------------------------
POSTGRES_DB=portfolio
# Owner / migration identity (runs `migrate`; never used by the running API).
POSTGRES_OWNER_USER=portfolio_owner
POSTGRES_OWNER_PASSWORD=change-me-owner-password
# Least-privilege application identity (DML only).
APP_DB_USER=portfolio_app
APP_DB_PASSWORD=change-me-app-password
POSTGRES_PORT=5432

# --- Administrator bootstrap (only used when no administrator exists yet) --------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Admin-Passw0rd

# --- Market data ------------------------------------------------------------------------------------------------
# Provider used on first start: Yahoo | AlphaVantage | Mock
MARKET_DATA_PROVIDER=Yahoo
# Optional – only needed for the Alpha Vantage provider.
ALPHAVANTAGE_API_KEY=your-alpha-vantage-key-here

# --- Language model for Matrix Pilot (optional) ----------------------------------------------------------------
# None = no model (default); Matrix Pilot then cannot decide (fail closed), everything else works.
# Anthropic = Claude via the official SDK (console.anthropic.com). Gemini = Google Gemini (aistudio.google.com).
AGENT_LLM_PROVIDER=None
# Empty = provider default (claude-opus-5-5 / gemini-3.8-flash).
AGENT_LLM_MODEL=
# Secret, server-side only: the key of the chosen provider (ANTHROPIC_API_KEY is also accepted for Anthropic).
LLM_API_KEY=

# Matrix Pilot's own model (empty = the shared model above): Gemini, Anthropic, Groq, OpenRouter, Mistral, Cerebras, OpenAI.
MATRIX_PILOT_PROVIDER=
MATRIX_PILOT_MODEL=
# Ordered fallbacks, tried only while no model of a decision cycle has answered (one model makes each decision), e.g.
#   MATRIX_PILOT_FALLBACKS=Gemini:gemini-3.8-flash; Groq:<model id>; OpenRouter:<model id>; Mistral:<model id>
# The owner confirms a changed list in the pilot's mandate. Use one account per provider – several free keys of one
# provider to get around its limits break its terms. See docs/matrix-pilot.md › Models.
MATRIX_PILOT_FALLBACKS=
# One key per provider (each key is only sent to its own provider).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=

ASPNETCORE_ENVIRONMENT=Development
