# Copy to .env (never commit .env). Used by docker-compose.yml. Replace every placeholder.

# --- PostgreSQL -------------------------------------------------------------------------------------------------
POSTGRES_DB=portfolio
# Owner / migration identity (runs `migrate`; never used by the running API).
POSTGRES_OWNER_USER=portfolio_owner
POSTGRES_OWNER_PASSWORD=change-me-owner-password
# Least-privilege application identity (DML only).
APP_DB_USER=portfolio_app
APP_DB_PASSWORD=change-me-app-password
POSTGRES_PORT=5432

# --- Administrator bootstrap (only used when no administrator exists yet) --------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Admin-Passw0rd

# --- Market data ------------------------------------------------------------------------------------------------
# Provider used on first start: Yahoo | AlphaVantage | Mock
MARKET_DATA_PROVIDER=Yahoo
# Optional – only needed for the Alpha Vantage provider.
ALPHAVANTAGE_API_KEY=your-alpha-vantage-key-here

# --- AI research assistant (optional) ---------------------------------------------------------------------------
# None = deterministic rules and templates only (default; everything works). Anthropic = Claude via the official SDK.
AGENT_LLM_PROVIDER=None
AGENT_LLM_MODEL=claude-opus-5-5
# Secret, server-side only. Leave empty unless AGENT_LLM_PROVIDER=Anthropic.
ANTHROPIC_API_KEY=

ASPNETCORE_ENVIRONMENT=Development
